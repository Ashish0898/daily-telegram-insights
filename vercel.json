{
  "rewrites": [
    { "source": "/", "destination": "/api/index.py" },
    { "source": "/api/telegram", "destination": "/api/index.py" },
    { "source": "/api/fact", "destination": "/api/index.py" },
    { "source": "/api/news", "destination": "/api/index.py" }
  ],
  "crons": [
    {
      "path": "/api/fact",
      "schedule": "30 1 * * *"
    },
    {
      "path": "/api/news",
      "schedule": "30 2 * * *"
    }
  ]
}
